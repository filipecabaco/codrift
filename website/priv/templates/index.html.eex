<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Codrift: run many AI coding agents at once</title>
    <meta
      name="description"
      content="A desktop control surface for running many AI coding agents at once. Live terminals, isolated worktrees, one diff, one shared memory, driven from the keyboard."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="<%= site_url %>/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Codrift" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content="<%= site_url %>/" />
    <meta property="og:title" content="Codrift: run many AI coding agents at once" />
    <meta
      property="og:description"
      content="Run Claude Code, Codex, Opencode, Gemini, Copilot and Cursor across every repo at once: isolated branches, one diff, one shared memory."
    />
    <meta property="og:image" content="<%= og_image %>" />
    <meta property="og:image:secure_url" content="<%= og_image %>" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Codrift wordmark above the headline &quot;Run many AI coding agents at once&quot;, over three dark terminal panels: claude on atlas-api running tests, claude on atlas-edge waiting for approval, codex on dashboard building."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Codrift: run many AI coding agents at once" />
    <meta
      name="twitter:description"
      content="Run Claude Code, Codex, Opencode, Gemini, Copilot and Cursor across every repo at once: isolated branches, one diff, one shared memory."
    />
    <meta name="twitter:image" content="<%= og_image %>" />
    <meta
      name="twitter:image:alt"
      content="Codrift wordmark above the headline &quot;Run many AI coding agents at once&quot;, over three dark terminal panels: claude on atlas-api running tests, claude on atlas-edge waiting for approval, codex on dashboard building."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="<%= tw_css %>" />
  </head>
  <body>
    <a href="#floor" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-amber focus:px-3 focus:py-2 focus:text-amber-ink">Skip to content</a>

    <!-- ══ NAV ══════════════════════════════════════════════════════════ -->
    <nav class="sticky top-0 z-50 border-b border-rule bg-ink/88 backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-[86rem] items-center gap-6 px-5 lg:px-8">
        <a href="/" class="flex items-center gap-2.5" aria-label="Codrift home">
          <svg width="20" height="20" viewBox="0 0 512 512" aria-hidden="true">
            <g stroke="oklch(75% 0.17 62)" fill="none" stroke-width="54" stroke-linecap="round">
              <path d="M94 326 L163.1 170.7" /><path d="M202 352 L290.7 152.9" /><path d="M310 378 L418.2 135" />
            </g>
          </svg>
          <span class="font-display text-[0.95rem] font-bold" style="font-stretch: 118%">codrift</span>
        </a>
        <div class="ml-auto flex items-center gap-5 text-sm text-muted">
          <a href="#floor" class="hidden hover:text-fg md:block">The floor</a>
          <a href="#conductor" class="hidden hover:text-fg md:block">Conductor</a>
          <a href="#keys" class="hidden hover:text-fg md:block">Keys</a>
          <a href="https://github.com/filipecabaco/codrift" class="hidden hover:text-fg sm:block">GitHub</a>
          <a
            href="#install"
            class="rounded bg-amber px-3 py-1.5 text-[0.8125rem] font-semibold text-amber-ink transition-colors hover:bg-amber-hot"
            >Install</a
          >
        </div>
      </div>
    </nav>

    <!-- ══ HERO ═════════════════════════════════════════════════════════ -->
    <header class="mx-auto max-w-[86rem] px-5 pb-16 pt-14 lg:px-8 lg:pb-24 lg:pt-24">
      <p class="t-tag rise mb-7" style="animation-delay: 40ms">
        Desktop · macOS &amp; Linux<%= if version do %> · <span class="text-amber">v<%= version %></span><% end %>
      </p>
      <!-- The wordmark is the brand mark, not the page's heading: it names the
           product but claims nothing about it. The h1 below carries the claim,
           which is the element a search result and a skimming reader both land
           on first. -->
      <div class="rise flex items-center gap-5 lg:gap-7" style="animation-delay: 90ms">
        <svg class="h-[0.78em] w-auto shrink-0 text-[clamp(3.4rem,9vw,7.5rem)]" viewBox="0 0 512 512" aria-hidden="true">
          <g stroke="currentColor" fill="none" stroke-width="54" stroke-linecap="round" style="color: var(--color-amber)">
            <path d="M94 326 L163.1 170.7" /><path d="M202 352 L290.7 152.9" /><path d="M310 378 L418.2 135" />
          </g>
        </svg>
        <span class="t-display" style="font-size: clamp(3.4rem, 9vw, 7.5rem)">codrift</span>
      </div>
      <h1 class="t-section rise mt-8 max-w-[26ch]" style="animation-delay: 130ms">
        Run many AI coding agents at once without losing track of one.
      </h1>
      <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,32rem)_minmax(0,1fr)] lg:items-end lg:gap-16">
        <div class="rise" style="animation-delay: 160ms">
          <p class="t-lead text-fg">
            Claude Code, Codex, Opencode, Gemini, Copilot, Cursor and raw shells, against every repo
            in a project at the same time.
          </p>
          <p class="t-lead mt-4">
            Live terminals, a branch per directory, one diff across all of it, and a memory store
            the agents share.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-4">
            <button class="cmd" type="button" data-copy="curl -fsSL https://codrift.app/install.sh | sh">
              <span class="text-amber">$</span>
              <span>curl -fsSL https://codrift.app/install.sh | sh</span>
              <span class="ml-1 text-faint" aria-hidden="true">⧉</span>
              <span class="sr-only">Copy install command</span>
            </button>
            <a href="https://github.com/filipecabaco/codrift" class="link-u text-sm">Source on GitHub</a>
          </div>
        </div>

        <div class="rise" style="animation-delay: 240ms">
          <div class="panel overflow-hidden" id="rig" aria-hidden="true">
            <div class="flex items-center gap-3 border-b border-rule px-4 py-2">
              <span class="t-tag shrink-0">initiative</span>
              <span class="min-w-0 flex-1 truncate font-mono text-[0.8125rem] text-fg">rate limits everywhere</span>
              <span class="t-tag shrink-0" id="rig-summary">4 agents</span>
            </div>
            <div id="rig-lanes" class="divide-y divide-rule"></div>
          </div>
          <p class="mt-3 font-mono text-[0.6875rem] text-faint" id="rig-caption">
            Four agents, three repos, one window. Live, from a real session.
          </p>
          <p class="mt-1.5 font-mono text-[0.6875rem] text-faint">
            <span class="keycap" data-key="j">j</span>
            <span class="keycap" data-key="k">k</span>
            hold a lane still, the same keys that move the sidebar cursor in the app.
          </p>
        </div>
      </div>
    </header>

    <!-- ══ 01 · THE FLOOR ═══════════════════════════════════════════════ -->
    <section id="floor" class="rule-t">
      <div class="mx-auto max-w-[86rem] px-5 py-20 lg:px-8 lg:py-28">
        <div class="channel">
          <p class="channel-id">01 / floor</p>
          <div>
            <h2 class="t-section max-w-[16ch]">Every agent, in its own terminal, on screen at once.</h2>
            <p class="t-body mt-6">
              Codrift does not wrap your agents or paraphrase them. Each one runs in a real PTY and
              renders byte-for-byte in an embedded terminal, so Claude Code looks like Claude Code
              and Codex looks like Codex. Split the pane and watch two of them at the same time.
            </p>
            <figure class="mt-10">
              <img
                src="/images/split-agents.webp"
                alt="Two Claude Code agents running side by side in Codrift: the left pane is proposing a Go edit, the right has just finished writing a failure-modes document"
                width="2000"
                height="1225"
                class="shot"
                loading="eager"
                fetchpriority="high"
              />
              <figcaption class="mt-3 font-mono text-[0.6875rem] text-faint">
                ⌘D splits the content area. Each half keeps its own initiative, agent and view.
              </figcaption>
            </figure>

            <div class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-px overflow-hidden rounded-lg border border-rule bg-rule sm:grid-cols-2">
              <div class="bg-ink p-6">
                <h3 class="font-display text-[1.0625rem] font-semibold">Seven adapters, one launcher</h3>
                <p class="t-body mt-2 text-[0.9375rem]">
                  Claude Code, Codex, Opencode, Gemini, Copilot, Cursor, and a raw
                  <code class="font-mono text-amber">$SHELL</code>. Start any of them against any
                  directory; run several in the same one if you want a second opinion.
                </p>
              </div>
              <div class="bg-ink p-6">
                <h3 class="font-display text-[1.0625rem] font-semibold">Sessions outlive the window</h3>
                <p class="t-body mt-2 text-[0.9375rem]">
                  Claude sessions are persisted and resumed. Quit Codrift, come back, and the agent
                  picks up the conversation instead of starting over.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ 02 · ATTENTION ════════════════════════════════════════════════ -->
    <section class="drench">
      <div class="mx-auto max-w-[86rem] px-5 py-20 lg:px-8 lg:py-28">
        <div class="channel">
          <p class="channel-id" style="color: inherit; border-color: currentColor; opacity: 0.72">02 / attention</p>
          <div>
            <h2 class="t-section max-w-[18ch]">
              Output stopped being scarce. Your attention didn’t.
            </h2>
            <p class="t-lead mt-6">
              Four agents will produce more work than you can read. The job is no longer typing, it
              is routing yourself to the one that is actually stuck. A row of terminal tabs cannot
              tell you which: a tab title carries the repo name, never the fact that an agent
              stopped ten minutes ago to ask something. So you check all four, every time. Codrift
              makes it a glance: every agent carries a state, the sidebar rolls them up per
              initiative, and anything waiting on a human says so in words, not just colour.
            </p>

            <ul class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-3 sm:grid-cols-2 lg:grid-cols-4">
              <li class="rounded-lg border border-amber-ink/25 p-4">
                <p class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.14em]">running</p>
                <p class="mt-2 text-[0.9375rem] leading-relaxed opacity-80">Working. Leave it alone.</p>
              </li>
              <li class="rounded-lg border border-amber-ink/25 bg-amber-ink/10 p-4">
                <p class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.14em]">needs input</p>
                <p class="mt-2 text-[0.9375rem] leading-relaxed opacity-80">
                  Asked you something. This is the only one that costs you time.
                </p>
              </li>
              <li class="rounded-lg border border-amber-ink/25 p-4">
                <p class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.14em]">idle</p>
                <p class="mt-2 text-[0.9375rem] leading-relaxed opacity-80">Finished its turn, holding the session.</p>
              </li>
              <li class="rounded-lg border border-amber-ink/25 p-4">
                <p class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.14em]">stopped</p>
                <p class="mt-2 text-[0.9375rem] leading-relaxed opacity-80">Exited or crashed, with its exit code.</p>
              </li>
            </ul>

            <figure class="mt-10">
              <img
                src="/images/agent-question.webp"
                alt="Codrift sidebar showing an initiative with 3 waiting, while an agent asks how the usage endpoint should carry two rate-limit scopes"
                width="2000"
                height="1010"
                class="shot" style="border-color: color-mix(in oklab, var(--color-amber-ink) 32%, transparent); background: color-mix(in oklab, var(--color-amber-ink) 6%, transparent)"
                loading="lazy"
              />
              <figcaption class="mt-3 font-mono text-[0.6875rem] opacity-70">
                “3 waiting” on the initiative row. You go straight there.
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ 03 · CONDUCTOR ═══════════════════════════════════════════════ -->
    <section id="conductor">
      <div class="mx-auto max-w-[86rem] px-5 py-20 lg:px-8 lg:py-28">
        <div class="channel">
          <p class="channel-id">03 / conductor</p>
          <div>
            <h2 class="t-section max-w-[17ch]">Hand the plan to an agent and let it run the others.</h2>
            <p class="t-body mt-6">
              Codrift ships an MCP server. Point one agent at it, give it the initiative, and it
              plans the work, starts sub-agents in the other directories, sends them instructions,
              reads their output, and writes what it learns to the shared memory. There is no glue
              code and no orchestration DSL: the conductor is just an agent with tools.
            </p>

            <div class="mt-10 grid grid-cols-[minmax(0,1fr)] items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-12">
              <div>
              <!-- Scrolls sideways on a phone rather than scaling down: at 350px
                   the diagram's labels render at ~5px, which is not readable. -->
              <div class="overflow-x-auto">
              <svg viewBox="0 0 664 332" class="w-full min-w-[42rem]" role="img" aria-labelledby="orch-title orch-desc">
                <title id="orch-title">How orchestration works in Codrift</title>
                <desc id="orch-desc">
                  A conductor agent calls Codrift’s MCP server over SSE. The server starts one
                  sub-agent per project directory, each in its own git worktree, and all of them read
                  and write a shared FTS5 memory store.
                </desc>
                <defs>
                  <marker id="ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M0 0 L10 5 L0 10 z" fill="oklch(46% 0.01 265)" />
                  </marker>
                  <marker id="ar-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M0 0 L10 5 L0 10 z" fill="oklch(75% 0.17 62)" />
                  </marker>
                </defs>

                <g font-family="JetBrains Mono, monospace">
                  <!-- conductor -->
                  <rect x="4" y="14" width="176" height="58" rx="8" fill="oklch(14% 0.014 265)" stroke="oklch(75% 0.17 62)" />
                  <text x="20" y="39" fill="oklch(94% 0.008 265)" font-size="13">conductor</text>
                  <text x="20" y="57" fill="oklch(66% 0.012 265)" font-size="10">claude · context dir</text>

                  <!-- mcp -->
                  <rect x="244" y="8" width="176" height="76" rx="8" fill="oklch(14% 0.014 265)" stroke="oklch(24% 0.014 265)" />
                  <text x="260" y="32" fill="oklch(94% 0.008 265)" font-size="13">Codrift MCP</text>
                  <text x="260" y="50" fill="oklch(66% 0.012 265)" font-size="10">:43117/mcp/sse</text>
                  <text x="260" y="70" fill="oklch(75% 0.17 62)" font-size="9">start_agent · send_to_agent</text>

                  <path d="M180 46 H236" stroke="oklch(75% 0.17 62)" stroke-width="1.5" marker-end="url(#ar-a)" />
                  <text x="186" y="38" fill="oklch(75% 0.17 62)" font-size="9">calls</text>

                  <!-- workers -->
                  <rect x="244" y="118" width="196" height="48" rx="8" fill="oklch(14% 0.014 265)" stroke="oklch(24% 0.014 265)" />
                  <circle cx="262" cy="142" r="4" fill="oklch(74% 0.17 150)" />
                  <text x="278" y="139" fill="oklch(94% 0.008 265)" font-size="12">claude · atlas-api</text>
                  <text x="278" y="155" fill="oklch(66% 0.012 265)" font-size="9">codrift/9e66/atlas-api</text>

                  <rect x="244" y="178" width="196" height="48" rx="8" fill="oklch(14% 0.014 265)" stroke="oklch(24% 0.014 265)" />
                  <circle cx="262" cy="202" r="4" fill="oklch(74% 0.17 150)" />
                  <text x="278" y="199" fill="oklch(94% 0.008 265)" font-size="12">codex · atlas-edge</text>
                  <text x="278" y="215" fill="oklch(66% 0.012 265)" font-size="9">codrift/9e66/atlas-edge</text>

                  <rect x="244" y="238" width="196" height="48" rx="8" fill="oklch(14% 0.014 265)" stroke="oklch(24% 0.014 265)" />
                  <circle cx="262" cy="262" r="4" fill="oklch(72% 0.15 232)" />
                  <text x="278" y="259" fill="oklch(94% 0.008 265)" font-size="12">claude · dashboard</text>
                  <text x="278" y="275" fill="oklch(66% 0.012 265)" font-size="9">codrift/9e66/dashboard</text>

                  <path d="M332 84 V110" stroke="oklch(46% 0.01 265)" stroke-width="1.5" marker-end="url(#ar)" />
                  <path d="M332 96 H216 V202 H236" fill="none" stroke="oklch(46% 0.01 265)" stroke-width="1.5" marker-end="url(#ar)" opacity="0.5" />
                  <path d="M216 202 V262 H236" fill="none" stroke="oklch(46% 0.01 265)" stroke-width="1.5" marker-end="url(#ar)" opacity="0.5" />

                  <!-- memory -->
                  <rect x="482" y="118" width="178" height="108" rx="8" fill="oklch(14% 0.014 265)" stroke="oklch(24% 0.014 265)" />
                  <text x="498" y="144" fill="oklch(94% 0.008 265)" font-size="13">shared memory</text>
                  <text x="498" y="165" fill="oklch(66% 0.012 265)" font-size="10">sqlite fts5</text>
                  <text x="498" y="184" fill="oklch(66% 0.012 265)" font-size="10">decision · summary</text>
                  <text x="498" y="202" fill="oklch(66% 0.012 265)" font-size="10">snippet · note</text>

                  <path d="M440 142 H474" stroke="oklch(46% 0.01 265)" stroke-width="1.5" marker-end="url(#ar)" marker-start="url(#ar)" />
                  <path d="M440 202 H460 V172 H474" fill="none" stroke="oklch(46% 0.01 265)" stroke-width="1.5" marker-end="url(#ar)" opacity="0.5" />
                  <path d="M440 262 H460 V172" fill="none" stroke="oklch(46% 0.01 265)" stroke-width="1.5" opacity="0.5" />
                </g>
              </svg>
              </div>
              <p class="t-body mt-8 max-w-[46ch] text-[0.9375rem]">
                Press <span class="keycap">o</span> to start orchestration on the selected
                initiative, or wire the MCP server into your own tooling with
                <code class="font-mono text-amber">codrift mcp install</code>.
              </p>
              </div>

              <div>
                <p class="t-tag mb-3">orchestration.md, read by the conductor</p>
                <pre class="panel overflow-x-auto p-4 font-mono text-[0.75rem] leading-relaxed text-muted"><code><span class="text-amber"># Rules for workers</span>

- Read the initiative memory
  before touching anything.
- Write a <span class="text-fg">decision</span> entry the
  moment you pick between
  two approaches.
- Never widen the public API
  without saying so in memory
  first.
- Stop and report if a change
  would need a migration.

<span class="text-amber">## Merge order</span>

edge -&gt; api -&gt; dashboard</code></pre>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ 04 · ISOLATION ═══════════════════════════════════════════════ -->
    <section class="rule-t bg-panel/40">
      <div class="mx-auto max-w-[86rem] px-5 py-20 lg:px-8 lg:py-28">
        <div class="channel">
          <p class="channel-id">04 / isolation</p>
          <div>
            <h2 class="t-section max-w-[16ch]">Six agents. Six branches. Your checkout untouched.</h2>
            <p class="t-body mt-6">
              Turn on worktrees for a directory and Codrift checks it out on
              <code class="font-mono text-amber">codrift/{id}/{slug}</code> before any agent starts.
              Parallel agents stop colliding, and nothing lands in your working tree until you
              decide it should. The diff view shows every change across the whole initiative in one
              scroll, so review is one pass, not six.
            </p>

            <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-12">
              <svg viewBox="0 0 300 210" class="w-full max-w-sm" role="img" aria-labelledby="wt-title wt-desc">
                <title id="wt-title">One trunk, three isolated branches</title>
                <desc id="wt-desc">
                  Your main branch continues untouched while Codrift creates one worktree branch per
                  project directory, each holding a single agent’s changes.
                </desc>
                <g font-family="JetBrains Mono, monospace" font-size="11">
                  <path d="M26 22 V188" stroke="oklch(46% 0.01 265)" stroke-width="2" />
                  <text x="40" y="20" fill="oklch(66% 0.012 265)">main · yours</text>
                  <circle cx="26" cy="34" r="4.5" fill="oklch(46% 0.01 265)" />
                  <circle cx="26" cy="188" r="4.5" fill="oklch(46% 0.01 265)" />

                  <path d="M26 70 C 78 70 78 62 122 62 H236" fill="none" stroke="oklch(75% 0.17 62)" stroke-width="2" />
                  <circle cx="236" cy="62" r="5" fill="oklch(75% 0.17 62)" />
                  <text x="122" y="52" fill="oklch(94% 0.008 265)">atlas-api</text>
                  <text x="122" y="80" fill="oklch(74% 0.17 150)">+30 −2</text>

                  <path d="M26 118 C 78 118 78 110 122 110 H236" fill="none" stroke="oklch(75% 0.17 62)" stroke-width="2" />
                  <circle cx="236" cy="110" r="5" fill="oklch(75% 0.17 62)" />
                  <text x="122" y="100" fill="oklch(94% 0.008 265)">atlas-edge</text>
                  <text x="122" y="128" fill="oklch(74% 0.17 150)">+41 −6</text>

                  <path d="M26 166 C 78 166 78 158 122 158 H236" fill="none" stroke="oklch(75% 0.17 62)" stroke-width="2" />
                  <circle cx="236" cy="158" r="5" fill="oklch(75% 0.17 62)" />
                  <text x="122" y="148" fill="oklch(94% 0.008 265)">atlas-dashboard</text>
                  <text x="122" y="176" fill="oklch(74% 0.17 150)">+22 −4</text>
                </g>
              </svg>

              <figure>
                <img
                  src="/images/diff-view.webp"
                  alt="Codrift diff view showing syntax-highlighted additions and deletions in lib/atlas/rate_limit.ex with a plus thirty, minus two summary"
                  width="2000"
                  height="1225"
                  class="shot"
                  loading="lazy"
                />
                <figcaption class="mt-3 font-mono text-[0.6875rem] text-faint">
                  <span class="keycap">2</span> shows every changed file across every directory, highlighted.
                </figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ 05 · MEMORY ══════════════════════════════════════════════════ -->
    <section class="rule-t">
      <div class="mx-auto max-w-[86rem] px-5 py-20 lg:px-8 lg:py-28">
        <div class="channel">
          <p class="channel-id">05 / memory</p>
          <div>
            <h2 class="t-section max-w-[16ch]">The context you keep re-typing, written down once.</h2>
            <p class="t-body mt-6">
              Every initiative carries a searchable SQLite FTS5 store. Agents read it before they
              start and write to it when they decide something. The next agent inherits the
              reasoning instead of rediscovering it, which is cheaper in tokens and much cheaper in
              contradictions.
            </p>

            <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-2 lg:gap-12">
              <div class="space-y-3">
                <article class="panel p-4">
                  <p class="mb-2 flex items-center gap-2 font-mono text-[0.625rem] uppercase tracking-[0.12em]">
                    <span class="rounded bg-done/20 px-1.5 py-0.5 text-done">decision</span>
                    <span class="text-faint">claude/atlas-api</span>
                  </p>
                  <p class="font-mono text-[0.8125rem] leading-relaxed text-muted">
                    Bucket key is <span class="text-fg">{api_token, route_class}</span>, not
                    api_token alone. A read loop must never starve a payout. Rejected: one global
                    bucket per token (simpler, but it couples the two failure modes).
                  </p>
                </article>
                <article class="panel p-4">
                  <p class="mb-2 flex items-center gap-2 font-mono text-[0.625rem] uppercase tracking-[0.12em]">
                    <span class="rounded bg-ok/20 px-1.5 py-0.5 text-ok">snippet</span>
                    <span class="text-faint">claude/atlas-api</span>
                  </p>
                  <p class="font-mono text-[0.8125rem] leading-relaxed text-muted">
                    <span class="text-fg">defp encode({token, class}), do: "rl:#{class}:#{token}"</span><br />
                    The edge must produce the identical key or the two layers count separately.
                  </p>
                </article>
                <article class="panel p-4">
                  <p class="mb-2 flex items-center gap-2 font-mono text-[0.625rem] uppercase tracking-[0.12em]">
                    <span class="rounded bg-wait/20 px-1.5 py-0.5 text-wait">note</span>
                    <span class="text-faint">conductor</span>
                  </p>
                  <p class="font-mono text-[0.8125rem] leading-relaxed text-muted">
                    Two accounts poll on a fixed 200ms interval with no jitter, so the sliding
                    window fills at exactly the same instant on every edge node.
                  </p>
                </article>
              </div>

              <figure>
                <img
                  src="/images/memory-view.webp"
                  alt="Codrift memory view listing decision, summary, snippet and note entries with a full-text search box"
                  width="2000"
                  height="1225"
                  class="shot"
                  loading="lazy"
                />
                <figcaption class="mt-3 font-mono text-[0.6875rem] text-faint">
                  FTS5 query syntax, straight through:
                  <span class="text-muted">redis AND fallback NOT dashboard</span>.
                </figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ 06 · VIEWS ════════════════════════════════════════════════════ -->
    <section id="keys" class="rule-t bg-panel/40">
      <div class="mx-auto max-w-[86rem] px-5 py-20 lg:px-8 lg:py-28">
        <div class="channel">
          <p class="channel-id">06 / keys</p>
          <div>
            <h2 class="t-section max-w-[19ch]">Three views, two panes, one focus ring.</h2>
            <p class="t-body mt-6">
              The keyboard is the interface, not a shortcut layer bolted on top. Views switch on a
              number, focus moves on a direction, and panes answer to their own number. The whole
              map comes from <code class="font-mono text-amber">~/.codrift/keybindings.json</code>,
              so you can rebind any of it.
              <span class="text-fg">The window below is a working model. Press the keys.</span>
            </p>

            <div class="mt-8" data-rig>
              <div class="rigwin" data-sidebar="open" role="img"
                   aria-label="A scale model of the Codrift window: sidebar on the left, one or two agent panes on the right, a focus ring you move with the keyboard.">
                <div class="rig-strip">
                  <span class="rig-lights" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="font-display font-bold text-fg" style="font-stretch: 118%">codrift</span>
                  <span class="flex items-center gap-1">
                    <span class="rig-tab" data-tab="context" aria-selected="true">1 Context</span>
                    <span class="rig-tab" data-tab="diff" aria-selected="false">2 Diff</span>
                    <span class="rig-tab" data-tab="tree" aria-selected="false">3 Tree</span>
                  </span>
                  <span class="ml-auto truncate text-faint" data-rig-where>focus: sidebar</span>
                </div>

                <div class="rig-grid">
                  <div class="rig-side" data-region="sidebar">
                    <p class="t-tag" style="font-size: 0.5625rem; line-height: 1.6">initiatives</p>
                    <div class="rig-row" data-lane><span class="dot" style="background: var(--color-ok)"></span><span class="text-fg">rate limits</span></div>
                    <div class="rig-row" data-lane style="padding-left: 0.85rem">initiative.md</div>
                    <div class="rig-row" data-lane style="padding-left: 0.85rem">orchestration.md</div>
                    <div class="rig-row" data-lane style="padding-left: 0.85rem">memory</div>
                    <div class="rig-row" data-lane style="padding-left: 0.85rem">atlas-api</div>
                    <div class="rig-row" data-lane style="padding-left: 1.5rem">claude</div>
                    <div class="rig-row" data-lane style="padding-left: 0.85rem">atlas-edge</div>
                    <div class="rig-row" data-lane style="padding-left: 1.5rem">claude</div>
                    <div class="rig-row" data-lane style="padding-left: 0.85rem">dashboard</div>
                    <div class="rig-row" data-lane style="padding-left: 1.5rem">codex</div>
                    <div class="rig-row" data-lane><span class="dot" style="background: var(--color-wait)"></span>adyen cutover</div>
                    <div class="rig-row" data-lane><span class="dot" style="background: var(--color-done)"></span>flaky test triage</div>
                  </div>
                  <div class="rig-content" data-split="none"></div>
                </div>

                <div class="rig-hints" data-rig-hints></div>
                <div class="rig-ring" data-rig-ring hidden></div>
              </div>
              <p class="mt-3 font-mono text-[0.6875rem] leading-relaxed text-faint">
                Press the keys, or click them in the legend. On this page they are all
                <span class="text-muted">⌃</span>: in the desktop app the split and the pane jumps
                are <span class="text-muted">⌘D</span>, <span class="text-muted">⌘⇧D</span> and
                <span class="text-muted">⌘1</span>, but your browser owns those here and we are not
                taking them.
              </p>
            </div>

            <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
              <div>
                <p class="t-tag mb-3">the sidebar has focus</p>
                <dl class="space-y-2 font-mono text-[0.8125rem]">
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><button type="button" class="keycap" data-key="j">j</button> <button type="button" class="keycap" data-key="k">k</button></dt><dd class="text-muted">move the cursor</dd></div>
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><button type="button" class="keycap" data-key="tab">⇥</button></dt><dd class="text-muted">into the pane</dd></div>
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><span class="keycap">s</span></dt><dd class="text-muted">start an agent</dd></div>
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><span class="keycap">b</span></dt><dd class="text-muted">branch the directories</dd></div>
                </dl>
              </div>
              <div>
                <p class="t-tag mb-3">a pane has focus</p>
                <dl class="space-y-2 font-mono text-[0.8125rem]">
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><button type="button" class="keycap" data-key="ctrl+left">⌃←</button> <button type="button" class="keycap" data-key="ctrl+right">⌃→</button></dt><dd class="text-muted">focus left / right</dd></div>
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><button type="button" class="keycap" data-key="ctrl+up">⌃↑</button> <button type="button" class="keycap" data-key="ctrl+down">⌃↓</button></dt><dd class="text-muted">focus up / down, stacked</dd></div>
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><button type="button" class="keycap" data-key="ctrl+1">⌃1</button> <button type="button" class="keycap" data-key="ctrl+2">⌃2</button></dt><dd class="text-muted">jump straight to a pane</dd></div>
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><button type="button" class="keycap" data-key="1">1</button> <button type="button" class="keycap" data-key="2">2</button> <button type="button" class="keycap" data-key="3">3</button></dt><dd class="text-muted">switch this pane's view</dd></div>
                </dl>
              </div>
              <div>
                <p class="t-tag mb-3">any time</p>
                <dl class="space-y-2 font-mono text-[0.8125rem]">
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><button type="button" class="keycap" data-key="ctrl+d">⌃D</button></dt><dd class="text-muted">split side by side</dd></div>
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><button type="button" class="keycap" data-key="ctrl+shift+d">⌃⇧D</button></dt><dd class="text-muted">split stacked</dd></div>
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><button type="button" class="keycap" data-key="ctrl+b">⌃B</button></dt><dd class="text-muted">collapse the sidebar</dd></div>
                  <div class="flex items-baseline gap-3"><dt class="w-[5.4rem] shrink-0"><button type="button" class="keycap" data-key="ctrl+p">⌃P</button></dt><dd class="text-muted">command palette</dd></div>
                </dl>
              </div>
            </div>

            <div class="mt-12 border-t border-rule pt-10 lg:max-w-[68ch]">
              <h3 class="font-display text-[1.15rem] font-bold" style="font-stretch: 118%">
                Why leaving a terminal takes a modifier
              </h3>
              <p class="t-body mt-3">
                Focus a pane running an agent and <span class="keycap">⇥</span> stops being ours. A
                shell wants it for completion, and Claude Code cycles its own modes with it, so the
                pane hands every keystroke to the PTY and the model above shows it landing there.
                That leaves <span class="keycap">⌃←</span> as the way back out.
                <span class="text-fg">It used to be <span class="keycap">⌃⎋</span></span>, which
                broke for an unpleasant reason: release the modifier a moment early and a lone
                <span class="keycap">⎋</span> reaches the agent, which reads it as
                <em>interrupt the running command</em>. Directions have no such half-pressed state.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ 07 · SURFACE ═════════════════════════════════════════════════ -->
    <section class="rule-t">
      <div class="mx-auto max-w-[86rem] px-5 py-20 lg:px-8 lg:py-28">
        <div class="channel">
          <p class="channel-id">07 / surface</p>
          <div>
            <h2 class="t-section max-w-[17ch]">Sixty-six themes, and the one you already use.</h2>
            <p class="t-body mt-6">
              Codrift reads VS Code theme JSON. Sixty-six are bundled; drop any other into
              <code class="font-mono text-amber">~/.codrift/themes</code> and it shows up in the
              picker. Theme and font apply live to the whole surface, terminals included, so the
              agent panes match everything else on your screen.
            </p>

            <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-3">
              <figure>
                <img src="/images/themes.webp" alt="Codrift theme picker filtering sixty-six bundled VS Code themes" width="2000" height="1225" class="shot" loading="lazy" />
                <figcaption class="mt-3 font-mono text-[0.6875rem] text-faint">Live preview with <span class="keycap">↑</span><span class="keycap">↓</span>, <span class="keycap">⏎</span> keeps, <span class="keycap">esc</span> reverts.</figcaption>
              </figure>
              <figure>
                <img src="/images/fonts.webp" alt="Codrift font picker showing installed monospace families and a size stepper" width="2000" height="1225" class="shot" loading="lazy" />
                <figcaption class="mt-3 font-mono text-[0.6875rem] text-faint">Your installed monospace families, with a size stepper.</figcaption>
              </figure>
              <figure>
                <img src="/images/theme-latte.webp" alt="The same Codrift tree view rendered in the light Catppuccin Latte theme" width="2000" height="1225" class="shot" loading="lazy" />
                <figcaption class="mt-3 font-mono text-[0.6875rem] text-faint">Same window, Catppuccin Latte. Light works too.</figcaption>
              </figure>
            </div>

            <div class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-12">
              <div>
                <h3 class="font-display text-[1.0625rem] font-semibold">Pull the work in, don’t retype it</h3>
                <p class="t-body mt-2">
                  Connect GitHub, GitHub Projects, GitLab, Linear or Linear Projects and import an
                  issue straight into an initiative’s context folder, where every agent picks it up
                  automatically through <code class="font-mono text-amber">--add-dir</code>.
                </p>
                <h3 class="mt-8 font-display text-[1.0625rem] font-semibold">Browse and edit without leaving</h3>
                <p class="t-body mt-2">
                  <span class="keycap">3</span> opens a gitignore-aware file tree with
                  syntax-highlighted previews, a fuzzy filter on <span class="keycap">/</span>, and a
                  CodeMirror editor with vim bindings on <span class="keycap">e</span>.
                </p>
              </div>
              <figure>
                <img src="/images/tree-filter.webp" alt="Fuzzy file filter in the Codrift tree view narrowing to three rate limit files" width="2000" height="1225" class="shot" loading="lazy" />
                <figcaption class="mt-3 font-mono text-[0.6875rem] text-faint">Typing <span class="text-muted">ratlim</span> finds <span class="text-muted">lib/atlas/rate_limit.ex</span>.</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ 08 · INSTALL ═════════════════════════════════════════════════ -->
    <section id="install" class="rule-t bg-panel/40">
      <div class="mx-auto max-w-[86rem] px-5 py-20 lg:px-8 lg:py-28">
        <div class="channel">
          <p class="channel-id">08 / install</p>
          <div>
            <h2 class="t-section max-w-[14ch]">One binary. No runtime to install.</h2>
            <p class="t-body mt-6">
              A native desktop app for macOS and Linux. No Node, no Erlang, no Ruby on your machine
              because the runtime ships inside. Bring your own agent CLIs and Codrift drives them.
            </p>

            <p class="mt-4 font-mono text-[0.8125rem] text-muted">
              MIT licensed, source on
              <a href="https://github.com/filipecabaco/codrift" class="link-u">GitHub</a>, free to run.
            </p>

            <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-3 sm:grid-cols-2 lg:max-w-3xl">
              <div class="sm:col-span-2">
                <p class="t-tag mb-2">the short way</p>
                <button class="cmd" type="button" data-copy="curl -fsSL https://codrift.app/install.sh | sh">
                  <span class="text-amber">$</span>
                  <span>curl -fsSL https://codrift.app/install.sh | sh</span>
                  <span class="ml-auto text-faint" aria-hidden="true">⧉</span>
                  <span class="sr-only">Copy install command</span>
                </button>
                <p class="mt-2 font-mono text-[0.75rem] text-faint">
                  Puts <span class="text-muted">Codrift.app</span> in Applications and the
                  <span class="text-muted">codrift</span> CLI in
                  <span class="text-muted">~/.local/bin</span>. Or pick one below.
                </p>
              </div>
              <button class="cmd" type="button" data-copy="brew tap filipecabaco/codrift https://github.com/filipecabaco/codrift">
                <span class="text-amber">$</span>
                <span class="truncate">brew tap filipecabaco/codrift …</span>
                <span class="ml-auto text-faint" aria-hidden="true">⧉</span>
                <span class="sr-only">Copy Homebrew tap command</span>
              </button>
              <button class="cmd" type="button" data-copy="brew install --cask codrift">
                <span class="text-amber">$</span>
                <span>brew install --cask codrift</span>
                <span class="ml-auto text-faint" aria-hidden="true">⧉</span>
                <span class="sr-only">Copy Homebrew install command</span>
              </button>
              <a
                href="https://github.com/filipecabaco/codrift/releases/latest"
                class="flex items-center gap-3 rounded-lg border border-rule bg-panel px-4 py-3 text-sm transition-colors hover:border-amber"
              >
                <span class="font-mono text-amber">↓</span>
                <span>macOS</span>
                <span class="ml-auto font-mono text-xs text-faint">.dmg</span>
              </a>
              <a
                href="https://github.com/filipecabaco/codrift/releases/latest"
                class="flex items-center gap-3 rounded-lg border border-rule bg-panel px-4 py-3 text-sm transition-colors hover:border-amber"
              >
                <span class="font-mono text-amber">↓</span>
                <span>Linux</span>
                <span class="ml-auto font-mono text-xs text-faint">.AppImage / .deb</span>
              </a>
            </div>

            <p class="mt-6 font-mono text-[0.75rem] leading-relaxed text-faint lg:max-w-3xl">
              Not yet code-signed or notarized. The cask strips the download quarantine; if macOS
              still objects, right-click → Open once. Then
              <span class="text-muted">codrift mcp install</span> registers the MCP server with
              Claude Code.
            </p>

            <div class="mt-12 border-t border-rule pt-10 lg:max-w-3xl">
              <h3 class="font-display text-[1.15rem] font-bold" style="font-stretch: 118%">
                From nothing to four running agents
              </h3>
              <ol class="mt-5 space-y-3">
                <li class="flex items-baseline gap-4">
                  <span class="keycap shrink-0">n</span>
                  <span class="t-body">New initiative. Name it after the work, not the repo.</span>
                </li>
                <li class="flex items-baseline gap-4">
                  <span class="keycap shrink-0">a</span>
                  <span class="t-body">Add the directories that work touches. Three repos is a normal number.</span>
                </li>
                <li class="flex items-baseline gap-4">
                  <span class="keycap shrink-0">b</span>
                  <span class="t-body">Put every git directory on its own branch.</span>
                </li>
                <li class="flex items-baseline gap-4">
                  <span class="keycap shrink-0">s</span>
                  <span class="t-body">Start an agent in each. The sidebar tells you which one needs you.</span>
                </li>
              </ol>
              <p class="t-body mt-5">
                That is the whole loop. Everything else on this page is what happens after step
                four.
              </p>
            </div>

            <div class="mt-12 border-t border-rule pt-10 lg:max-w-3xl">
              <p class="t-body">
                <code class="font-mono text-amber">codrift update</code> reads the releases API,
                checks the tarball against the SHA-256 published beside it, unpacks into a staging
                directory, and swaps it in with two renames, so a download that dies halfway never
                leaves you with half a release. It will not touch a Homebrew-managed install:
                rewriting a Cellar prefix behind brew corrupts its manifest, and the next
                <code class="font-mono text-amber">brew upgrade</code> would undo the whole thing.
                And when another <code class="font-mono text-amber">codrift</code> sits earlier on
                your <code class="font-mono text-amber">PATH</code>, it tells you, rather than
                updating a copy you are never going to run.
              </p>
              <div class="mt-5 grid grid-cols-[minmax(0,1fr)] gap-3 sm:grid-cols-2">
                <button class="cmd" type="button" data-copy="codrift update">
                  <span class="text-amber">$</span>
                  <span>codrift update</span>
                  <span class="ml-auto text-faint" aria-hidden="true">⧉</span>
                  <span class="sr-only">Copy update command</span>
                </button>
                <button class="cmd" type="button" data-copy="codrift update --check">
                  <span class="text-amber">$</span>
                  <span>codrift update --check</span>
                  <span class="ml-auto text-faint" aria-hidden="true">⧉</span>
                  <span class="sr-only">Copy update check command</span>
                </button>
              </div>
              <p class="mt-4 font-mono text-[0.75rem] leading-relaxed text-faint">
                <span class="text-muted">--check</span> exits 0 when there is something newer and 1
                when there isn’t, so it drops straight into a shell prompt or a login script.
              </p>
            </div>

            <div class="mt-12 border-t border-rule pt-10 lg:max-w-3xl">
              <h3 class="font-display text-[1.15rem] font-bold" style="font-stretch: 118%">
                Teach your agents to drive it
              </h3>
              <p class="t-body mt-3">
                The MCP server hands agents the tools. The skills teach them when to reach for
                them: search the shared memory before exploring, check what the other agents in
                the initiative are touching, write findings back so the next session starts ahead.
              </p>
              <ul class="mt-5 grid gap-x-8 gap-y-2 font-mono text-[0.8125rem] text-muted sm:grid-cols-2">
                <li><span class="text-amber">codrift</span> — the workspace model</li>
                <li><span class="text-amber">codrift-memory</span> — the shared store</li>
                <li><span class="text-amber">codrift-initiatives</span> — dirs, worktrees, diffs</li>
                <li><span class="text-amber">codrift-orchestration</span> — fan-out &amp; conductor</li>
                <li><span class="text-amber">codrift-integrations</span> — GitHub, Linear, GitLab</li>
              </ul>
              <div class="mt-6">
                <button class="cmd" type="button" data-copy="npx skills add filipecabaco/codrift">
                  <span class="text-amber">$</span>
                  <span>npx skills add filipecabaco/codrift</span>
                  <span class="ml-auto text-faint" aria-hidden="true">⧉</span>
                  <span class="sr-only">Copy skills install command</span>
                </button>
              </div>
              <p class="mt-4 font-mono text-[0.75rem] leading-relaxed text-faint">
                Installs into Claude Code, Codex, Cursor, Gemini CLI, Copilot and Opencode. Add
                <span class="text-muted">-g</span> to install for every project. Or run
                <span class="text-muted">Setup</span> from the command palette
                (<span class="text-muted">⌃P</span>) and Codrift opens a terminal that does both
                this and <span class="text-muted">codrift mcp install</span> for you.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ FOOTER ═══════════════════════════════════════════════════════ -->
    <footer class="rule-t">
      <div class="mx-auto flex max-w-[86rem] flex-wrap items-center gap-x-8 gap-y-4 px-5 py-10 lg:px-8">
        <a href="/" class="flex items-center gap-2.5" aria-label="Codrift home">
          <svg width="18" height="18" viewBox="0 0 512 512" aria-hidden="true">
            <g stroke="oklch(75% 0.17 62)" fill="none" stroke-width="54" stroke-linecap="round">
              <path d="M94 326 L163.1 170.7" /><path d="M202 352 L290.7 152.9" /><path d="M310 378 L418.2 135" />
            </g>
          </svg>
          <span class="font-display text-sm font-bold text-muted" style="font-stretch: 118%">codrift</span>
        </a>
        <nav class="flex flex-wrap gap-6 font-mono text-[0.75rem] text-faint">
          <a href="https://github.com/filipecabaco/codrift" class="hover:text-muted">GitHub</a>
          <a href="https://github.com/filipecabaco/codrift/blob/main/README.md" class="hover:text-muted">Docs</a>
          <a href="https://github.com/filipecabaco/codrift/blob/main/docs/keyboard.md" class="hover:text-muted">Keyboard</a>
          <a href="https://github.com/filipecabaco/codrift/issues" class="hover:text-muted">Issues</a>
        </nav>
        <p class="ml-auto font-mono text-[0.75rem] text-faint">Elixir · Rust · Svelte</p>
      </div>
    </footer>

    <script>
      for (const el of document.querySelectorAll("[data-copy]")) {
        el.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(el.dataset.copy);
          } catch {
            return;
          }
          const mark = el.querySelector("[aria-hidden]");
          if (!mark) return;
          const was = mark.textContent;
          mark.textContent = "copied";
          mark.classList.add("text-amber");
          setTimeout(() => {
            mark.textContent = was;
            mark.classList.remove("text-amber");
          }, 1400);
        });
      }

      // ── The page has a keyboard ──────────────────────────────────────
      //
      // One key spec format for the whole page, mirroring the app's own
      // eventToSpec: named keys spelled out, and ⌘ folded into ctrl so a single
      // binding string covers both platforms. Every .keycap[data-key] on the
      // page lights when its key is genuinely struck, which is the argument the
      // section makes, made without words.
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

      const NAMED = {
        arrowleft: "left",
        arrowright: "right",
        arrowup: "up",
        arrowdown: "down",
        escape: "esc",
        " ": "space",
      };

      function specOf(e) {
        const raw = e.key.toLowerCase();
        if (raw === "control" || raw === "meta" || raw === "shift" || raw === "alt") return null;
        const key = NAMED[raw] ?? raw;
        let spec = "";
        if (e.ctrlKey || e.metaKey) spec += "ctrl+";
        if (e.altKey) spec += "alt+";
        // Shift is only part of a spec when something else is holding the combo
        // together; on its own it just capitalises the character.
        if (e.shiftKey && spec) spec += "shift+";
        return spec + key;
      }

      function typingInPage(e) {
        const t = e.target;
        return t instanceof HTMLElement && !!t.closest("input, textarea, select, [contenteditable]");
      }

      const capTimers = new WeakMap();

      function strike(spec) {
        for (const cap of document.querySelectorAll('.keycap[data-key="' + CSS.escape(spec) + '"]')) {
          cap.classList.add("is-down");
          clearTimeout(capTimers.get(cap));
          capTimers.set(cap, setTimeout(() => cap.classList.remove("is-down"), 150));
        }
      }

      // ── The rig ──────────────────────────────────────────────────────
      //
      // A model of the window that obeys the same focus rules the app does, so
      // reading the legend and driving the thing are the same act. The rules
      // below are transcribed from App.svelte's moveFocus, deliberately
      // including the parts that do nothing: moving past the last pane in a
      // direction is a no-op rather than a wrap, because in a two-item row a
      // wrap is indistinguishable from not moving.
      (() => {
        const root = document.querySelector("[data-rig]");
        if (!root) return;

        const win = root.querySelector(".rigwin");
        const side = root.querySelector(".rig-side");
        const content = root.querySelector(".rig-content");
        const ring = root.querySelector("[data-rig-ring]");
        const hints = root.querySelector("[data-rig-hints]");
        const where = root.querySelector("[data-rig-where]");
        const tabs = [...root.querySelectorAll(".rig-tab")];
        const lanes = [...root.querySelectorAll("[data-lane]")];

        const VIEWS = {
          context: { src: "/images/context-pane.webp", alt: "the initiative brief rendered as markdown" },
          diff: { src: "/images/diff-view-pane.webp", alt: "a syntax-highlighted diff of the initiative's changes" },
          tree: { src: "/images/tree-view-pane.webp", alt: "a file tree beside a syntax-highlighted preview" },
        };

        const st = {
          focus: "sidebar",
          pane: 0,
          split: null,
          lane: 0,
          sidebar: "open",
          palette: false,
          views: ["context", "diff"],
          swallowed: false,
        };
        let swallowTimer;

        function paneCount() {
          return st.split ? 2 : 1;
        }

        // Panes are reconciled rather than rebuilt: replacing the markup would
        // re-request the screenshot and blink it on every split toggle.
        function syncPanes() {
          while (content.children.length > paneCount()) content.lastElementChild.remove();
          while (content.children.length < paneCount()) {
            const pane = document.createElement("div");
            pane.className = "rig-pane";
            pane.innerHTML = '<span class="rig-badge"></span><img alt="" loading="lazy" />';
            content.appendChild(pane);
          }
          [...content.children].forEach((pane, i) => {
            const view = VIEWS[st.views[i]];
            const img = pane.querySelector("img");
            if (!img.src.endsWith(view.src)) {
              img.src = view.src;
              img.alt = "Pane " + (i + 1) + ": " + view.alt;
            }
            pane.querySelector(".rig-badge").textContent = String(i + 1);
            pane.classList.toggle("is-active", st.focus === "pane" && st.pane === i);
          });
        }

        const HINT = (spec, label, flag) =>
          '<span class="' + (flag ? "is-swallowed" : "") + '"><b>' + spec + "</b> " + label + "</span>";

        function hintRow() {
          const view = st.views[st.pane];
          if (st.focus === "pane" && view === "context") {
            // A focused terminal owns every key it can use, ⇥ included, so the
            // only ways out are the focus keys and the palette. Same list the
            // app's own footer shows in this state.
            return (
              HINT("⌃←", "Sidebar", st.swallowed) + HINT("⇧⏎", "Newline") + HINT("⌃P", "Commands")
            );
          }
          if (st.focus === "pane" && view === "tree") {
            return HINT("↑↓", "Move") + HINT("⇥", "Sidebar") + HINT("/", "Filter files") + HINT("⌃P", "Commands");
          }
          if (st.focus === "pane") {
            return HINT("↑↓", "Move") + HINT("⌃←", "Sidebar") + HINT("⌃P", "Commands");
          }
          return (
            HINT("↑↓", "Move") +
            HINT("⇥", "Terminal") +
            HINT("s", "Start agent") +
            HINT("⌘D", "Split") +
            HINT("⌃P", "Commands")
          );
        }

        function placeRing() {
          const target = st.focus === "sidebar" ? side : content.children[st.pane];
          if (!target || (st.focus === "sidebar" && st.sidebar === "collapsed")) {
            ring.hidden = true;
            return;
          }
          const first = ring.hidden;
          ring.hidden = false;
          ring.style.left = target.offsetLeft + "px";
          ring.style.top = target.offsetTop + "px";
          ring.style.width = target.offsetWidth + "px";
          ring.style.height = target.offsetHeight + "px";
          if (!first && !reducedMotion) {
            ring.animate([{ opacity: 0.3 }, { opacity: 1 }], {
              duration: 150,
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
            });
          }
        }

        function render() {
          win.dataset.sidebar = st.sidebar;
          content.dataset.split = st.split ?? "none";
          syncPanes();
          for (const t of tabs) {
            t.setAttribute("aria-selected", String(t.dataset.tab === st.views[st.pane]));
          }
          lanes.forEach((l, i) => l.classList.toggle("is-cursor", st.focus === "sidebar" && st.lane === i));
          where.textContent = st.swallowed
            ? "⇥ went to the agent"
            : st.focus === "sidebar"
              ? "focus: sidebar"
              : st.views[st.pane] === "context"
                ? "focus: terminal"
                : "focus: pane " + (st.pane + 1);
          where.classList.toggle("text-amber", st.swallowed);
          where.classList.toggle("text-faint", !st.swallowed);
          hints.innerHTML = hintRow();
          root.querySelector(".rig-palette")?.remove();
          if (st.palette) {
            const overlay = document.createElement("div");
            overlay.className = "rig-palette";
            overlay.innerHTML =
              '<img src="/images/command-palette-dialog.webp" alt="The Codrift command palette, listing every action with the key it is bound to" />';
            win.appendChild(overlay);
          }
          placeRing();
        }

        function enterPane(i) {
          if (i >= paneCount()) return;
          st.focus = "pane";
          st.pane = i;
        }

        function moveFocus(dir) {
          const sideBySide = st.split === "vertical";
          const stacked = st.split === "horizontal";
          if (dir === "left") {
            if (st.focus !== "pane") return;
            if (sideBySide && st.pane === 1) enterPane(0);
            else {
              st.sidebar = "open";
              st.focus = "sidebar";
            }
            return;
          }
          if (dir === "right") {
            if (st.focus === "sidebar") enterPane(st.pane);
            else if (sideBySide && st.pane === 0) enterPane(1);
            return;
          }
          if (!stacked || st.focus !== "pane") return;
          if (dir === "up" && st.pane === 1) enterPane(0);
          if (dir === "down" && st.pane === 0) enterPane(1);
        }

        function toggleSplit(dir) {
          st.split = st.split === dir ? null : dir;
          if (!st.split) st.pane = 0;
        }

        // The teaching beat. ⇥ from the sidebar walks into the pane; ⇥ once a
        // terminal has focus never reaches us at all, so the model says so
        // instead of quietly doing nothing.
        function tab() {
          if (st.focus === "pane" && st.views[st.pane] === "context") {
            st.swallowed = true;
            clearTimeout(swallowTimer);
            swallowTimer = setTimeout(() => {
              st.swallowed = false;
              render();
            }, 1800);
            return;
          }
          if (st.focus === "pane") st.focus = "sidebar";
          else enterPane(st.pane);
        }

        function run(spec) {
          if (st.palette && spec !== "ctrl+p") {
            st.palette = false;
            if (spec === "esc") return true;
          }
          switch (spec) {
            case "1":
            case "2":
            case "3":
              st.views[st.pane] = ["context", "diff", "tree"][Number(spec) - 1];
              return true;
            case "j":
              st.focus = "sidebar";
              st.lane = Math.min(lanes.length - 1, st.lane + 1);
              return true;
            case "k":
              st.focus = "sidebar";
              st.lane = Math.max(0, st.lane - 1);
              return true;
            case "tab":
              tab();
              return true;
            case "ctrl+left":
            case "ctrl+right":
            case "ctrl+up":
            case "ctrl+down":
              moveFocus(spec.slice(5));
              return true;
            case "ctrl+d":
              toggleSplit("vertical");
              return true;
            case "ctrl+shift+d":
              toggleSplit("horizontal");
              return true;
            case "ctrl+b":
              st.sidebar = st.sidebar === "open" ? "collapsed" : "open";
              if (st.sidebar === "collapsed" && st.focus === "sidebar") enterPane(st.pane);
              return true;
            case "ctrl+p":
              st.palette = !st.palette;
              return true;
            case "esc":
              return false;
          }
          if (/^ctrl\+[1-9]$/.test(spec)) {
            enterPane(Number(spec.slice(5)) - 1);
            return true;
          }
          return false;
        }

        // Armed only while the rig is on screen. Off screen the page keeps its
        // own keys (scrolling, find-in-page) and nothing is intercepted.
        let armed = false;
        new IntersectionObserver(
          ([e]) => {
            armed = e.isIntersecting;
          },
          { threshold: 0.35 },
        ).observe(win);

        addEventListener("keydown", (e) => {
          if (typingInPage(e)) return;
          // ⌘ belongs to the browser here. Bookmarking and printing are not
          // ours to break for a demo, so the page is a ⌃ instrument and says so.
          if (e.metaKey) return;
          const spec = specOf(e);
          if (!spec) return;
          strike(spec);

          // The bare view keys work from anywhere on the page and bring the rig
          // with them; everything else needs the rig in front of you.
          const isViewKey = spec === "1" || spec === "2" || spec === "3";
          if (!armed && !isViewKey) return;

          if (!run(spec)) return;
          e.preventDefault();
          render();
          if (!armed) win.scrollIntoView({ block: "center", behavior: reducedMotion ? "auto" : "smooth" });
        });

        for (const cap of document.querySelectorAll("#keys .keycap[data-key]")) {
          cap.addEventListener("click", () => {
            strike(cap.dataset.key);
            if (run(cap.dataset.key)) render();
          });
        }

        new ResizeObserver(placeRing).observe(win);
        render();
      })();

      (() => {
        const host = document.getElementById("rig-lanes");
        const summary = document.getElementById("rig-summary");
        const caption = document.getElementById("rig-caption");
        if (!host) return;

        const STATES = {
          running: ["running", "var(--color-ok)"],
          waiting: ["needs input", "var(--color-amber)"],
          idle: ["idle", "var(--color-muted)"],
          done: ["done", "var(--color-done)"],
        };

        const LANES = [
          {
            agent: "claude",
            dir: "atlas-api",
            steps: [
              ["running", "Read lib/atlas/rate_limit.ex"],
              ["running", "Read lib/atlas/redis.ex"],
              ["running", "Bash  rg -n 'CL.THROTTLE' lib/"],
              ["running", "14 failure modes traced from the fallback"],
              ["running", "Write docs/failure-modes.md"],
              ["running", "Edit test/atlas/rate_limit_test.exs  +58"],
              ["done", "Worked for 3m 27s"],
            ],
          },
          {
            agent: "claude",
            dir: "atlas-edge",
            steps: [
              ["running", "Read proxy/limiter.go"],
              ["running", "Retry-After is whole seconds (RFC 9110 §10.2.3)"],
              ["running", "Edit proxy/limiter.go  +21 −3"],
              ["waiting", "Do you want to make this edit to limiter.go?"],
              ["running", "go test ./proxy -run Jitter"],
              ["done", "ok  github.com/atlas/edge/proxy  0.31s"],
            ],
          },
          {
            agent: "claude",
            dir: "atlas-dashboard",
            steps: [
              ["running", "Read src/lib/quota.ts"],
              ["running", "Grep x-ratelimit-scope   3 hits"],
              ["waiting", "How does /v1/usage carry both scopes' quotas?"],
              ["running", "Edit src/routes/usage/+page.svelte  +34 −7"],
              ["running", "vitest run src/lib/quota.test.ts"],
              ["done", "3 files changed, 12 tests passing"],
            ],
          },
          {
            agent: "codex",
            dir: "atlas-edge",
            steps: [
              ["running", "reap goroutine: keys older than window deleted"],
              ["running", "memory_add decision  #5"],
              ["idle", "waiting on merge order: edge → api → dashboard"],
            ],
          },
        ];

        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

        const lanes = LANES.map((lane, i) => {
          const el = document.createElement("div");
          el.className = "lane flex items-start gap-3 px-4 py-2.5";
          el.innerHTML =
            '<span class="dot mt-[0.42rem]"></span>' +
            '<div class="min-w-0 flex-1">' +
            '<p class="font-mono text-[0.6875rem] text-faint">' +
            '<span class="text-muted">' + lane.agent + "</span> · " + lane.dir +
            "</p>" +
            '<p class="mt-0.5 truncate font-mono text-[0.75rem] text-fg" data-line></p>' +
            "</div>" +
            '<span class="mt-[0.15rem] shrink-0 font-mono text-[0.625rem] uppercase tracking-[0.1em]" data-state></span>';
          host.appendChild(el);
          return {
            ...lane,
            el,
            dot: el.querySelector(".dot"),
            line: el.querySelector("[data-line]"),
            state: el.querySelector("[data-state]"),
            at: reduced ? lane.steps.length - 1 : 0,
          };
        });

        function paint(lane) {
          const [state, text] = lane.steps[lane.at];
          const [label, color] = STATES[state];
          lane.dot.style.background = color;
          lane.state.textContent = label;
          lane.state.style.color = color;
          lane.line.textContent = text;
          lane.line.classList.toggle("caret", state === "running" && !reduced);
        }

        function refreshSummary() {
          const waiting = lanes.filter((l) => l.steps[l.at][0] === "waiting").length;
          summary.textContent = waiting ? waiting + " waiting" : lanes.length + " agents";
          summary.style.color = waiting ? "var(--color-amber)" : "";
        }

        lanes.forEach(paint);
        refreshSummary();

        // ── The panel takes keys too ──────────────────────────────────
        //
        // j/k are the app's own sidebar cursor, so the hero answers to them
        // before you have read a word about the keyboard. The lane under the
        // cursor stops advancing, which is the point rather than a nicety: a
        // line you want to read is a line that has to hold still.
        let cursor = -1;
        function paintCursor() {
          lanes.forEach((lane, i) => lane.el.classList.toggle("is-cursor", i === cursor));
          caption.textContent =
            cursor < 0
              ? "Four agents, three repos, one window. Live, from a real session."
              : "Holding " + lanes[cursor].agent + " · " + lanes[cursor].dir + ". Esc releases it.";
        }
        function moveCursor(delta) {
          cursor = Math.max(0, Math.min(lanes.length - 1, (cursor < 0 ? -1 : cursor) + delta));
          paintCursor();
        }

        let heroArmed = false;
        new IntersectionObserver(([e]) => { heroArmed = e.isIntersecting; }, { threshold: 0.4 }).observe(host);

        addEventListener("keydown", (e) => {
          if (!heroArmed || e.metaKey || e.ctrlKey || e.altKey) return;
          const t = e.target;
          if (t instanceof HTMLElement && t.closest("input, textarea, select, [contenteditable]")) return;
          const key = e.key.toLowerCase();
          if (key === "j") moveCursor(1);
          else if (key === "k") moveCursor(cursor < 0 ? 0 : -1);
          else if (key === "escape" && cursor >= 0) { cursor = -1; paintCursor(); }
          else return;
          e.preventDefault();
        });

        if (reduced) return;

        // Independent clocks per lane, so the panel never marches in step.
        lanes.forEach((lane, i) => {
          const tick = () => {
            if (lanes[cursor] !== lane) {
              lane.at = (lane.at + 1) % lane.steps.length;
              paint(lane);
              refreshSummary();
            }
            setTimeout(tick, 1900 + i * 430 + (lane.at % 3) * 520);
          };
          setTimeout(tick, 900 + i * 620);
        });
      })();
    </script>
  </body>
</html>
